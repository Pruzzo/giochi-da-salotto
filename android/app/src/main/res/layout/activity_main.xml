<?xml version="1.0" encoding="utf-8"?>
<!-- Spazi dalla scala di docs/Guida-di-stile.md: 4, 8, 12, 16, 24dp. Bersagli tattili da 48dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kraft"
    android:orientation="vertical">

    <!-- La barra: un nastro Dymo con lo stato del server e l'indirizzo, da leggere per intero. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ink"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <View
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/tape_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/home"
            style="@style/BarButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/home"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Il registro: la striscia di carta di una macchina da scrivere, su fondo scuro. -->
        <LinearLayout
            android:id="@+id/log_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ink"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/log_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="@string/log"
                    android:textAllCaps="true"
                    android:textColor="@color/tape_soft"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/log_copy"
                    style="@style/BarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/log_copy" />

                <Button
                    android:id="@+id/log_close"
                    style="@style/BarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/log_close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tape_line" />

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.35"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp"
                    android:textColor="@color/tape_text"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
