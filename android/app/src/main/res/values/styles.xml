<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/red</item>
        <item name="android:colorPrimaryDark">@color/red_deep</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:statusBarColor">@color/red_deep</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="PlayButton" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@android:color/white</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HeaderButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
