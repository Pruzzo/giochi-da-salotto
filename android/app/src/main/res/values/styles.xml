<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/red</item>
        <item name="android:colorPrimaryDark">@color/red_deep</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:statusBarColor">@color/red_deep</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="HeaderButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
