<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:colorAccent">@color/red</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/kraft</item>
        <item name="android:popupMenuStyle">@style/Menu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MenuText</item>
    </style>

    <!-- I comandi sul nastro: testo, mai un bottone pieno. Il carattere lo mette MainActivity. -->
    <style name="BarButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/tape_text</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Menu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_bg</item>
    </style>

    <style name="MenuText" parent="android:TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
